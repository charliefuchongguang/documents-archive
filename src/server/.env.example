# 服务配置
PORT=3000
JWT_SECRET=your-jwt-secret-key

# DeepSeek API
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# MineRU PDF转Markdown（异步 /tasks，对齐 hegui）
MINERU_BASE_URL=http://192.168.3.6:8002
MINERU_HEALTH_URL=http://192.168.3.6:8002/health
MINERU_PARSE_TIMEOUT_MS=300000
MINERU_MAX_CONCURRENT=2
MINERU_POLL_INTERVAL_MS=5000
MINERU_TASK_TIMEOUT_MS=1800000
MINERU_FORCE_REPARSE=false
MINERU_FILE_QUEUE_CONCURRENCY=10
MINERU_OUTPUT_DIR=/tmp/mineru_docarchive_outputs
# 兼容旧变量：若以 /tasks 结尾，会解析为 baseUrl
# MINERU_PARSE_URL=http://192.168.3.6:8002/tasks

# 本地存储（相对 server/，不要前导 /）
LOCAL_STORAGE_BASE_PATH=uploads/archives
LOCAL_STORAGE_TEMP_PATH=uploads/temp

# NAS 存储
NAS_ENABLED=true
NAS_WEBDAV_URL=https://nas.example.com/dav/
NAS_USERNAME=admin
NAS_PASSWORD=password
NAS_BASE_PATH=/归档文件
NAS_UPLOAD_MAX_RETRIES=3
NAS_UPLOAD_RETRY_DELAY_MS=5000
